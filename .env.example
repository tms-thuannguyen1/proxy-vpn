# Copy to .env and fill in your VPN account: cp .env.example .env
VPN_SERVER=your_vpn_server_ip      # VPN server IP or domain
# VPN_SERVER_ID=192.168.100.1      # Optional: server IKE ID to require (default: accept any)
VPN_PSK=your_preshared_key         # IPsec pre-shared key (secret)
VPN_USER=your_vpn_username
VPN_PASSWORD=your_vpn_password

# Optional: forward local ports to hosts behind the VPN, for apps that cannot
# use a SOCKS proxy (DB clients, ssh...). Format: local_port:host:remote_port,...
# Local ports must be inside FORWARD_PORTS (default 41000-41009).
# PORT_FORWARDS=41000:mydb.xxxx.ap-northeast-1.rds.amazonaws.com:3306,41001:10.0.0.5:22
# FORWARD_PORTS=41000-41009
